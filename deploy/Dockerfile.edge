FROM caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
COPY deploy/Caddyfile /etc/caddy/Caddyfile
# Port 80 stays: Docker lowers net.ipv4.ip_unprivileged_port_start to 0 in container network
# namespaces, so a non-root user can bind it. Compose mounts /data and /config as tmpfs owned by
# this uid; chown on the declared VOLUME paths would not survive the legacy builder.
RUN addgroup -g 65532 -S edge \
    && adduser -u 65532 -S -G edge -H -s /sbin/nologin edge
USER 65532:65532
EXPOSE 80
