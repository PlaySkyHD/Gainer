FROM postgres:18.6-alpine3.24@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
RUN apk add --no-cache rclone restic
COPY deploy/scripts/backup.sh /usr/local/bin/backup.sh
COPY deploy/scripts/restore.sh /usr/local/bin/restore.sh
RUN chmod 0555 /usr/local/bin/backup.sh /usr/local/bin/restore.sh
ENTRYPOINT ["/usr/local/bin/backup.sh"]
