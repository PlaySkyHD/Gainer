GAINER_SITE_ADDRESS=:80
GAINER_EDGE_PORT=8081
GAINER_SECRETS_DIR=/etc/gainer/secrets
GAINER_API_IMAGE=registry.example.com/gainer-api:2026.08.18-1
GAINER_MIGRATOR_IMAGE=registry.example.com/gainer-migrator:2026.08.18-1
GAINER_EDGE_IMAGE=registry.example.com/gainer-edge:2026.08.18-1
GAINER_BACKUP_IMAGE=registry.example.com/gainer-backup:2026.08.18-1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
MEAL_ESTIMATION_DAILY_REQUESTS_PER_USER=20
MEAL_ESTIMATION_MAXIMUM_CONCURRENT_REQUESTS=2
MEAL_IMAGE_MAXIMUM_BYTES=8388608
MEAL_IMAGE_MAXIMUM_DIMENSION=4096
MEAL_IMAGE_MAXIMUM_PIXELS=16000000
MEAL_IMAGE_JPEG_QUALITY=82
OPENFOODFACTS_CONTACT_EMAIL=operator@example.invalid
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org/
OPENFOODFACTS_TIMEOUT_SECONDS=8
OPENFOODFACTS_MAXIMUM_RESPONSE_BYTES=1000000
OPENFOODFACTS_BARCODE_REQUESTS_PER_MINUTE=12
OPENFOODFACTS_SEARCH_REQUESTS_PER_MINUTE=8
AZURE_STORAGE_ACCOUNT_NAME=gainerbackups
RESTIC_REPOSITORY=azure:gainer-backups:/vps
