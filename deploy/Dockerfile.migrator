FROM mcr.microsoft.com/dotnet/sdk:10.0.103 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Gainer.Migrator/Gainer.Migrator.csproj --locked-mode
RUN dotnet publish src/Gainer.Migrator/Gainer.Migrator.csproj --no-restore -c Release -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0.3 AS runtime
WORKDIR /app
COPY --from=build /out .
USER 1654
ENTRYPOINT ["dotnet", "Gainer.Migrator.dll"]
