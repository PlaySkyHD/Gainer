{
    admin off

    # Only host Caddy (via the loopback-published port) and the private Compose networks reach
    # this edge. Trusting them keeps the real client address in X-Forwarded-For, which the API
    # needs for its per-client rate limits.
    servers {
        trusted_proxies static private_ranges
    }
}

{$GAINER_SITE_ADDRESS::80} {
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    }

    # Lets iOS bind passkeys of the app to this domain (webcredentials).
    handle /.well-known/apple-app-site-association {
        header Content-Type application/json
        respond `{"webcredentials":{"apps":["{$GAINER_APPLE_APP_ID:Q7GTYQ282F.xyz.markfort.gainer}"]}}` 200
    }

    handle /api/v1/* {
        reverse_proxy api:8080 {
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
        }
    }

    handle /health/* {
        reverse_proxy api:8080 {
            header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
            header_up X-Forwarded-Host {http.request.header.X-Forwarded-Host}
        }
    }

    handle {
        respond 404
    }
}
