{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "DataProtection": {
      "KeysPath": ".data-protection-keys"
    }
  },
  "OpenFoodFacts": {
    "BaseUrl": "https://world.openfoodfacts.org/",
    "ApplicationName": "Gainer",
    "ApplicationVersion": "1.0",
    "TimeoutSeconds": 8,
    "MaximumResponseBytes": 1000000,
    "BarcodeRequestsPerMinute": 12,
    "SearchRequestsPerMinute": 8,
    "BarcodeCacheMinutes": 1440,
    "BarcodeStaleHours": 168,
    "SearchCacheMinutes": 5
  },
  "AllowedHosts": "*"
}
